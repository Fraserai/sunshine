# Client-safe configuration only. Anything EXPO_PUBLIC_* is embedded in the app bundle,
# so never put an API key here.

# Where the Sunshine backend is reachable from the phone.
# Simulator:      http://localhost:8787
# Physical iPhone: http://<your-mac-LAN-ip>:8787   (e.g. http://192.168.1.24:8787)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787

# How many segments the canvas may auto-continue. Every segment is a PAID fal generation.
# 1 = no automatic continuation at all. Raise only deliberately.
EXPO_PUBLIC_VISUAL_MAX_AUTO_SEGMENTS=1

# Your Apple Personal Team ID, for local device signing.
# Find it with: defaults read com.apple.dt.Xcode | grep teamID
APPLE_TEAM_ID=
