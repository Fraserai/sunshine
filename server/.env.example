# ---- Server secrets. Never commit the filled-in version, never ship to the device. ----

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Created by `npm run provision:agent` (it prints the id to paste back here)
ELEVENLABS_AGENT_ID=

# fal.ai: https://fal.ai/dashboard/keys
FAL_KEY=

# ---- Optional tuning ----
PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# 768P is the product default. Set 480P only to cut cost while debugging.
VISUAL_RESOLUTION=768P
VISUAL_DURATION_SECONDS=5
VISUAL_PROMPT_EXPANSION=balanced
VISUAL_TIMEOUT_MS=120000

# ---- Cost control ----
# fal generations cost real money. These defaults are deliberately conservative.

# Serve local placeholder clips instead of calling fal. Nothing is billed.
# Exercises crossfade, preload, epochs, staleness and interruption for free.
VISUAL_DRY_RUN=true

# Retries after a transient fal failure. Each retry is a SECOND billed generation,
# and a timeout retry can bill twice for work that also completes. 0 = never retry.
VISUAL_MAX_RETRIES=0

# Only needed if the phone reaches this server via a different host than it dials
# (a tunnel or proxy). Otherwise the request's own host is used.
PUBLIC_BASE_URL=
